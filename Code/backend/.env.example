# TurboSMTP
SMTP_HOST=pro.eu.turbo-smtp.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-new-consumer-key
SMTP_PASSWORD=replace-with-new-consumer-secret
SMTP_FROM=SyncStock <your-sender-address@example.com>

# Existing application settings
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace-with-database-password
DB_NAME=inventory_db
DB_SSL=false
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175,http://localhost:5176,http://127.0.0.1:5176
TRUST_PROXY_HOPS=0
# Set all Turnstile settings in production. Leave unset for local development.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# TURNSTILE_ALLOWED_HOSTNAMES=inventory.example.com

# Required only when bootstrapping a new production database
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
